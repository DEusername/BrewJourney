// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Insert schemas for entity tables setup by dylan key

model Grinders {
  id Int @id @default(autoincrement())
  grinderName String
  minSettingFine Int
  maxSettingCoarse Int
  user Users?
  brewLogs BrewLogs[]
}

model Users { 
  id Int @id @default(autoincrement())
  email String @unique
  password String @default("1234") // Need to salt
  firstName String
  lastName String
  createdAt DateTime @default(now())
  grinder Grinders? @relation(fields: [grinderId], references: [id])
  grinderId Int? @unique
  brewLogs BrewLogs[]
  conversations Conversations[]
}

model BrewMethods { // Reference Table
  id Int @id @default(autoincrement())
  methodName String
  defaultRatio String // Represented as coffee:water (grams) i.e. 1:3
  description String // Could be changed to a different data type to handle more text, if possible
  brewLogs BrewLogs[]
}

model BrewLogs {
  id Int @id @default(autoincrement())

  // Foreign Keys
  user Users @relation(fields: [userId], references: [id])
  userId Int
  grinder Grinders? @relation(fields: [grinderId], references: [id]) // Not all users/brewlogs will have a grinder (pre-ground coffee!)
  grinderId Int?
  brewMethod BrewMethods @relation(fields: [brewMethodId], references: [id]) 
  brewMethodId Int

  coffeeName String
  roastLevel Int // 1-5: Light, Medium-Light, Medium, Medium-Dark, Dark
  targetRatio String // coffee:water ratio (in grams)
  doseGrams Int // Grams are usually measured in whole numbers, right? Rarely have half a gram
  targetWaterGrams Int // Recommended water grams for the method/grounds, auto-calculated and stored in the brew log
  actualWaterGrams Int // User inputted, weighed after the coffee is made
  grindSize Int // Number used on grinder?
  brewTimeSeconds Float
  waterTemp Float
  resultRating Int // 1-5 rating: Bad, Okay, Good, Excellent, Perfect
  notes String // User enters notes about the taste, will be used by AI
  createdOn DateTime @default(now())
}

model Conversations {
  id Int @id @default(autoincrement())
  user Users @relation(fields: [userId], references: [id])
  userId Int
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime?
  messages Messages[]
}

model Messages {
  id Int @id @default(autoincrement())
  conversation Conversations @relation(fields: [conversationId], references: [id])
  conversationId Int
  context String // The 'context' of the message, i.e. messages preceding that led up to this answer/message
  createdAt DateTime @default(now())
}